@startuml
skinparam maxMessageSize 200
autonumber

actor "Admin" as admin

box "Frontend" #LightCyan
boundary "LoginPage" as loginPage
boundary "DashboardPage" as dashPage
boundary "PlayerPage" as playerPage
boundary "PlayerDetailComponent" as playerDetail
boundary "CardsPage" as cardsPage
boundary "TradePage" as tradePage
end box

box "Controllers" #LightYellow
control "AuthController" as authCtrl
control "PlayerController" as playerCtrl
control "CardController" as cardCtrl
control "TradeController" as tradeCtrl
end box

box "Services" #LightGreen
entity "AuthService" as authSvc
entity "PlayerService" as playerSvc
entity "CardService" as cardSvc
entity "TradeService" as tradeSvc
end box

actor "Jogadores" as actorJogadores #CornflowerBlue
actor "Cartas" as actorCartas #LightSalmon
actor "Trocas" as actorTrocas #LightSteelBlue

== 1. Fluxo de Autenticação ==
admin -> loginPage: login(token: string)
activate loginPage
loginPage -> authCtrl: validarToken(token: string)
activate authCtrl
authCtrl -> authSvc: verificarToken(token: string)
activate authSvc
authSvc -> authSvc: estaAutenticado()
authSvc --> authCtrl: boolean
deactivate authSvc
authCtrl --> loginPage: status
deactivate authCtrl

alt Autenticado
    loginPage -> dashPage: redireciona
    activate dashPage
    dashPage -> dashPage: verificarAcesso()
else Falha
    loginPage --> admin: Exibe erro
end
deactivate loginPage

== 2. Gestão de Jogadores (PlayerPage) ==
admin -> dashPage: navegarParaJogadores()
dashPage -> playerPage: abrir
deactivate dashPage
activate playerPage

playerPage -> playerPage: carregarJogadores()
playerPage -> playerCtrl: buscarJogadores(nome?: string)
activate playerCtrl
playerCtrl -> playerSvc: buscarTodos()
activate playerSvc
playerSvc -> actorJogadores: Query: listar todos
actorJogadores --> playerSvc: Player[]
playerSvc --> playerCtrl: Player[]
deactivate playerSvc
playerCtrl --> playerPage: Player[]
deactivate playerCtrl

opt Ações Administrativas (Banir/Promover)
    admin -> playerPage: atualizarBanimento(id, statusBanimento: bool)
    playerPage -> playerCtrl: atualizarStatusBanimento(id, statusBanimento)
    activate playerCtrl
    playerCtrl -> playerSvc: atualizarBanimento(id, statusBanimento)
    activate playerSvc
    playerSvc -> actorJogadores: UPDATE Player status
    actorJogadores --> playerSvc: sucesso
    playerSvc --> playerCtrl: confirmação
    deactivate playerSvc
    playerCtrl --> playerPage: feedback
    deactivate playerCtrl

    admin -> playerPage: atualizarNivel(id: string)
    playerPage -> playerCtrl: atualizarNivelUsuario(id: string)
    activate playerCtrl
    playerCtrl -> playerSvc: atualizarNivel(id, nivel)
    activate playerSvc
    playerSvc -> actorJogadores: UPDATE Player level
    actorJogadores --> playerSvc: sucesso
    playerSvc --> playerCtrl: confirmação
    deactivate playerSvc
    playerCtrl --> playerPage: feedback
    deactivate playerCtrl
end

== 3. Detalhes e Inventário (PlayerDetailComponent) ==
admin -> playerPage: abrirDetalhes(id: string)
playerPage -> playerDetail: inicializar(id)
activate playerDetail

par 
    playerDetail -> playerDetail: carregarPerfil(id)
    playerDetail -> playerCtrl: buscarJogadores(id)
    playerCtrl -> playerSvc: buscarPorNome(id)
    playerSvc -> actorJogadores: Fetch detalhado
    actorJogadores --> playerSvc: Player

    playerDetail -> playerDetail: carregarCartas(id)
    playerDetail -> cardCtrl: buscarCartas(id_usuario)
    cardCtrl -> cardSvc: buscarCartas()
    cardSvc -> actorCartas: Query: inventário do player
    actorCartas --> cardSvc: Card[]

    playerDetail -> playerDetail: carregarTrocas(id)
    playerDetail -> tradeCtrl: buscarTrocas(id_usuario)
    tradeCtrl -> tradeSvc: buscarTrocas()
    tradeSvc -> actorTrocas: Query: histórico do player
    actorTrocas --> tradeSvc: Trade[]
end
deactivate playerDetail

== 4. Listagem Geral de Cartas (CardsPage) ==
admin -> dashPage: navegarParaCartas()
activate cardsPage
cardsPage -> cardCtrl: buscarCartas(nome?, tipo?)
activate cardCtrl
cardCtrl -> cardSvc: buscarPorTipo(tipo)
activate cardSvc
cardSvc -> actorCartas: Query: lista filtrada
actorCartas --> cardSvc: Card[]
deactivate cardSvc
cardCtrl --> cardsPage: Card[]
deactivate cardCtrl
deactivate cardsPage

== 5. Histórico de Trocas (TradePage) ==
admin -> dashPage: navegarParaTrocas()
activate tradePage
tradePage -> tradePage: carregarTrocas()
tradePage -> tradeCtrl: buscarTrocas(status?, card?: Card[])
activate tradeCtrl
tradeCtrl -> tradeSvc: buscarPorStatus(status)
activate tradeSvc
tradeSvc -> actorTrocas: Query: trocas por status
actorTrocas --> tradeSvc: Trade[]
deactivate tradeSvc
tradeCtrl --> tradePage: Trade[]
deactivate tradeCtrl
deactivate tradePage

@enduml